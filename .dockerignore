# Build context allowlist: private host state is never sent to Docker or E2B.
**
!pyproject.toml
!uv.lock
!.gitignore
!README.md
!AGENTS.md
!start.sh
!src/
!src/**
!tests/
!tests/**
!benchmarks/
!benchmarks/**
!demo/
!demo/recorded/
!demo/recorded/**
!.e2b/
!.e2b/**
!.relai/
!.relai/runtime-manifest.json
!.relai/evals-wiki/
!.relai/evals-wiki/**
!.relai/harbor/
!.relai/harbor/**
!.relai/.internal/
!.relai/.internal/layout.json
!.relai/.internal/records/
!.relai/.internal/records/**
**/__pycache__/
**/*.pyc
**/.cache/
**/.pytest_cache/
**/.env
**/simulator.env
**/config.toml
