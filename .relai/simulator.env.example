# Configure runtime values in .relai/simulator.env, not in task assets.
# Use OPENAI_API_KEY or ANTHROPIC_API_KEY; alternatively use the existing
# scoped provider with AIRLINE_MODEL_PROVIDER=relai and its three variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AIRLINE_MODEL_PROVIDER=
RELAI_API_BASE=
RELAI_SESSION_MODEL=
RELAI_TEAM_API_KEY=
OPENAI_AGENTS_DISABLE_TRACING=
ATIF_REDACT_ENV_VARS=
