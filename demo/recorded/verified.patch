+@pytest.mark.asyncio
+async def test_real_agent_policy_reaches_streaming_model_each_turn(monkeypatch, tmp_path):
+    """Check real construction/runner wiring, not booking-reasoning semantics."""
+    instructions = []
+    selections = []
+
+    class PolicyModel(FakeModel):
+        async def stream_response(self, system_instructions, *args, **kwargs):
+            instructions.append(system_instructions)
+            async for event in super().stream_response(system_instructions, *args, **kwargs):
+                yield event
+
+    model = PolicyModel([[message("First answer")], [message("Second answer")]])
+
+    def select_fake_model():
+        selections.append(model)
+        return ModelSelection(provider="test", model=model)
+
+    # Keep create_airline_agent and the SDK streaming runner real.
+    monkeypatch.setattr(sample, "select_model", select_fake_model)
+    path = tmp_path / "policy-trajectory.json"
+    history = []
+    for user, answer in [("First question", "First answer"), ("Verify again", "Second answer")]:
+        history.append(ChatMessage("user", user, "now"))
+        output = "".join(
+            [chunk async for chunk in sample.stream_agent_response(history, trajectory_path=path)]
+        )
+        assert output == answer
+        history.append(ChatMessage("assistant", output, "now"))
+
+    assert len(selections) == 2
+    assert instructions == [sample.AIRLINE_AGENT_INSTRUCTIONS] * 2
+    assert [step["message"] for step in document(path)["steps"]] == [
+        "First question",
+        "First answer",
+        "Verify again",
+        "Second answer",
+    ]
+
