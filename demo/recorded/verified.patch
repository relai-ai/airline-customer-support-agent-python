+async def test_real_baggage_observations_through_shared_entrypoint(
+    monkeypatch, tmp_path, ticket_type, expected
+):
+    """Forced tool calls test SDK plumbing and policy text, not model compliance."""
+    monkeypatch.delenv("RELAI_ATIF_TRAJECTORY_PATH", raising=False)
+    path = tmp_path / "trajectory.json"
+    model = FakeModel(
+        [
+            [call(name="baggage_policy", arguments=json.dumps({"ticket_type": ticket_type}))],
+            [message("Policy received")],
+        ]
+    )
+    # Keep the actual construction site, instructions, tools, and streaming runner.
+    monkeypatch.setattr(sample, "select_model", lambda: SimpleNamespace(model=model))
+
+    output = "".join(
+        [
+            chunk
+            async for chunk in sample.stream_agent_response(
+                [ChatMessage("user", "What is the baggage policy?", "now")],
+                trajectory_path=path,
+            )
+        ]
+    )
+
+    assert output == "Policy received"
+    steps = document(path)["steps"]
+    assert steps[1]["tool_calls"] == [
