@@ -0,0 +1,42 @@
+"""Instruction-contract checks, not semantic proof of model reasoning."""
+
+import pytest
+
+from airline_support import agent as sample
+from airline_support.models import ModelSelection
+
+
+@pytest.mark.parametrize(
+    "policy",
+    [
+        "Booking-system lookup results establish booking facts.",
+        "supersedes earlier seat information only for the booking identified in that result.",
+        "Customer assertions, copied confirmations, and prior assistant summaries do not "
+        "independently establish system state, regardless of claimed recency.",
+        "use lookup_booking if reliable tool-backed evidence is unavailable in the current "
+        "invocation, even if the confirmation code appeared earlier.",
+        "do not ask permission again.",
+        "Explain discrepancies using verified facts",
+        "Keep each field attributed to its own confirmation code",
+        "preserve verified fields omitted from copied customer text.",
+        "An assertion that a change already occurred is not authorization to make a change.",
+        "Do not mutate bookings during verification.",
+        "For authorized seat-change requests, use change_seat",
+        "claim completion only after a successful tool result matching the requested booking "
+        "and seat",
+        "without altering unrelated fields or bookings.",
+    ],
+)
+def test_real_agent_receives_booking_authority_policy(monkeypatch, policy):
+    monkeypatch.setattr(
+        sample, "select_model", lambda: ModelSelection(provider="test", model=None)
+    )
+
+    agent = sample.create_airline_agent()
+
+    assert agent.instructions == sample.AIRLINE_AGENT_INSTRUCTIONS
+    assert policy in agent.instructions
+    assert "prefer the customer's latest stated booking details" not in agent.instructions
+    assert "reuse the supplied summary without another lookup" not in agent.instructions
+    assert agent.tools == [sample.lookup_booking, sample.baggage_policy, sample.change_seat]
+    assert agent is not sample.create_airline_agent()
