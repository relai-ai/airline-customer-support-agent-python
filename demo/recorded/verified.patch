new file mode 100644
index 0000000..02f7074
--- /dev/null
+++ b/tests/test_airline_agent.py
@@ -0,0 +1,26 @@
+from __future__ import annotations
+
+import pytest
+
+from airline_support import agent as sample
+from airline_support.models import ModelSelection
+
+
+@pytest.mark.parametrize("model", [None, "offline-model"])
+def test_construction_uses_shared_contract_and_existing_tools(monkeypatch, model):
+    """Check construction wiring, not whether a model follows the instructions."""
+    monkeypatch.setattr(
+        sample, "select_model", lambda: ModelSelection(provider="offline", model=model)
+    )
+
+    agent = sample.create_airline_agent()
+
+    assert agent.name == "SkyServe Airline Support"
+    assert agent.model == model
+    assert agent.instructions == sample.AIRLINE_AGENT_INSTRUCTIONS
+    assert agent.tools == [sample.lookup_booking, sample.baggage_policy, sample.change_seat]
+    assert [tool.name for tool in agent.tools] == [
+        "lookup_booking",
+        "baggage_policy",
+        "change_seat",
+    ]
