diff --git a/src/airline_support/trajectory.py b/src/airline_support/trajectory.py
index 160644b..222823e 100644
--- a/src/airline_support/trajectory.py
+++ b/src/airline_support/trajectory.py
@@ -72,6 +72,26 @@ def redact(value: Any, secrets: tuple[str, ...]) -> Any:
             decoded = None
         if isinstance(decoded, (dict, list)):
             return json.dumps(redact(decoded, secrets), ensure_ascii=False)
+        # Diagnostics can embed JSON in prose or Markdown fences. Parse complete
+        # containers so quoted keys and escaped values use structured redaction.
+        decoder = json.JSONDecoder()
+        parts = []
+        end = 0
+        for match in re.finditer(r"[\[{]", value):
+            if match.start() < end:
+                continue
+            try:
+                embedded, consumed = decoder.raw_decode(value, match.start())
+            except ValueError:
+                continue
+            filtered = redact(embedded, secrets)
+            parts.append(value[end:match.start()])
+            end = consumed
+            parts.append(
+                json.dumps(filtered, ensure_ascii=False)
+                if filtered != embedded else value[match.start():end]
+            )
+        value = "".join(parts) + value[end:]
         return _SECRET_TEXT.sub(REDACTED, value)
     return value
 
diff --git a/tests/test_embedded_redaction.py b/tests/test_embedded_redaction.py
new file mode 100644
index 0000000..ef6e653
--- /dev/null
+++ b/tests/test_embedded_redaction.py
@@ -0,0 +1,37 @@
+import json
+
+import pytest
+
+from airline_support.trajectory import REDACTED, redact
+
+
+@pytest.mark.parametrize(
+    "diagnostic",
+    [
+        {"password": "opaque-example", "ticket_type": "standard"},
+        {"nested": [{"api_key": 'opaque-"quoted"-value'}]},
+        [{"access_token": "opaque-token"}, {"weight": 50}],
+    ],
+)
+def test_fenced_json_uses_structured_redaction(diagnostic):
+    message = "Baggage diagnostic:\n```json\n" + json.dumps(diagnostic) + "\n```\nThanks."
+    result = redact(message, ())
+    assert result.startswith("Baggage diagnostic:\n```json\n")
+    assert result.endswith("\n```\nThanks.")
+    assert json.loads(result.split("```json\n")[1].split("\n```")[0]) == redact(
+        diagnostic, ()
+    )
+    assert REDACTED in result
+
+
+def test_multiple_json_fragments_after_non_json_braces():
+    message = 'Note {not JSON}; first {"password":"one"}; second {"secret":"two"}.'
+    assert redact(message, ()) == (
+        'Note {not JSON}; first {"password": "[REDACTED]"}; '
+        'second {"secret": "[REDACTED]"}.'
+    )
+
+
+def test_benign_embedded_json_preserves_original_formatting():
+    message = 'Baggage { "weight" : 50, "items": [1, 2] } and [ordinary prose].'
+    assert redact(message, ()) == message
